# justfile - Interface canonica TypeScript do harness (instalado via `harness init`).
default:
    @just --list

check:
    npm run build

lint:
    npm run lint

test:
    npm run test -- --run

# Auto-avaliacao local do diff contra as regras normativas do Judge
judge-local:
    npx harness judge --local || harness judge --local

verify: check lint test
